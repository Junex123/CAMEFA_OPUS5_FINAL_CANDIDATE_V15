generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DecisionReceipt {
  receiptId     String   @id
  slug          String   @unique
  schema        String
  sealedAt      DateTime
  epoch         Json
  versions      Json
  request       Json
  decision      Json
  coverage      Json
  fragility     Json?
  inputDigest   String
  outputDigest  String
  lineageDigest String
  createdAt     DateTime @default(now())

  evaluation Evaluation?
  lineage    DecisionLineage?

  @@index([sealedAt(sort: Desc)])
  @@index([inputDigest])
  @@map("decision_receipt")
}

model Evaluation {
  receiptId   String          @id
  receipt     DecisionReceipt @relation(fields: [receiptId], references: [receiptId], onDelete: Cascade)
  primitive   String
  asOf        DateTime
  cost        Json
  determinism String
  warnings    String[]
  actorKind   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([primitive, updatedAt(sort: Desc)])
  @@map("evaluation")
}

model DecisionLineage {
  receiptId String          @id
  receipt   DecisionReceipt @relation(fields: [receiptId], references: [receiptId], onDelete: Cascade)
  payload   Json
  byteSize  Int

  @@map("decision_lineage")
}
